# Public canonical origin used for metadata, robots, and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://hooded.world

# Server-only. Never expose these with NEXT_PUBLIC_ prefixes.
DATABASE_URL=postgresql://user:password@host:5432/hooded
SOCIETY_SESSION_SECRET=replace-with-at-least-32-random-characters
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BASE_RPC_URL=https://mainnet.base.org
HOODED_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_HERO_ADDRESS=0x0000000000000000000000000000000000000000
RH_HERO_REWARD_VAULT_ADDRESS=
RH_HERO_REWARD_VAULT_CODE_HASH=
BASE_HERO_REWARD_VAULT_ADDRESS=
BASE_HERO_REWARD_VAULT_CODE_HASH=

# Owner-only mainnet canary. Leave disabled and blank until the reviewed factories exist.
ENABLE_MAINNET_CANARY=false
LAUNCH_CANARY_OWNER_ADDRESS=
RH_FACTORY_DEPLOYER_ADDRESS=
RH_LAUNCH_FACTORY_ADDRESS=
RH_LAUNCH_FACTORY_CODE_HASH=
BASE_LAUNCH_FACTORY_ADDRESS=
BASE_LAUNCH_FACTORY_CODE_HASH=
RH_CANARY_SALE_ADDRESS=
RH_CANARY_SALE_CODE_HASH=
RH_CANARY_MANIFEST_HASH=
BASE_CANARY_SALE_ADDRESS=
BASE_CANARY_SALE_CODE_HASH=
BASE_CANARY_MANIFEST_HASH=
RUN_MAINNET_FORK_TESTS=false

# Fail-closed feature flag. Enable only after the database, gate, limits, and Vercel project are configured.
ENABLE_VERCEL_SANDBOX=false
SANDBOX_BASE_COMMIT=
SANDBOX_REPOSITORY_URL=
WEB_EVM_SANDBOX_SNAPSHOT_ID=
SOLANA_SANDBOX_SNAPSHOT_ID=

# Vercel OIDC is automatic in production. These are only for an explicitly authorized local integration.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# GitHub App values are intentionally blank until the least-privilege app is installed.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
